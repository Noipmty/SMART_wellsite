# ==================== 智慧井场多智能体系统 环境配置 ====================
# 复制为 .env 后填写实际值

# ---- 运行环境 ----
ENV=dev
LOG_LEVEL=DEBUG

# ---- PostgreSQL（业务数据） ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=wellsite
POSTGRES_USER=wellsite
POSTGRES_PASSWORD=wellsite_dev_2026

# ---- TDengine（时序数据） ----
TDENGINE_HOST=localhost
TDENGINE_PORT=6030
TDENGINE_USER=root
TDENGINE_PASSWORD=taosdata
TDENGINE_DATABASE=wellsite

# ---- Redis（缓存/会话/Stream 事件总线） ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- MySQL（模拟事件总线，本地开发用） ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=wellsite_bus
MYSQL_USER=wellsite
MYSQL_PASSWORD=wellsite_dev_2026

# ---- MinIO（对象存储，可选） ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=wellsite

# ---- Neo4j（知识图谱，阶段二启用） ----
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=neo4j_dev_2026

# ---- Milvus（向量库，阶段二启用） ----
# MILVUS_HOST=localhost
# MILVUS_PORT=19530

# ---- LLM 配置 ----
LLM_PROVIDER=mock
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3
LLM_TOKEN_BUDGET=4096

# 豆包 / DeepSeek 预留（当前不用）
# DOUBAO_API_KEY=
# DOUBAO_BASE_URL=
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=

# ---- LangSmith 追踪 ----
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=smart-wellsite

# ---- Prometheus 指标 ----
PROMETHEUS_PORT=9090

# ---- FastAPI 网关 ----
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# ---- 事件总线实现选择 ----
# 可选: memory / mysql / redis_stream
EVENTBUS_BACKEND=mysql

# ---- 安全配置 ----
SECRET_KEY=change-me-in-production
AUDIT_LOG_ENABLED=true
